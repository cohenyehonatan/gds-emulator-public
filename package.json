{
  "name": "gds-emulator",
  "version": "0.1.0",
  "description": "Emulator for a Sabre-style GDS host: cryptic entry parsing, AAA work-area session state, and PNR lifecycle",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start:server": "tsx src/index.ts server",
    "start:terminal": "tsx src/index.ts terminal",
    "start:terminal:sabre": "tsx src/index.ts terminal sabre",
    "start:terminal:galileo": "tsx src/index.ts terminal galileo",
    "scenario": "tsx src/index.ts scenario",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
