{
  "name": "gds-emulator",
  "version": "0.1.0",
  "description": "Emulator for a Sabre-style GDS host: cryptic entry parsing, AAA work-area session state, and PNR lifecycle",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts directory",
    "start:server": "tsx src/index.ts server",
    "start:server:sabre": "tsx src/index.ts server sabre",
    "start:server:galileo": "tsx src/index.ts server galileo",
    "start:server:apollo": "tsx src/index.ts server apollo",
    "start:server:amadeus": "tsx src/index.ts server amadeus",
    "start:server:worldspan": "tsx src/index.ts server worldspan",
    "dev:server": "tsx watch src/index.ts server",
    "dev:server:sabre": "tsx watch src/index.ts server sabre",
    "dev:server:galileo": "tsx watch src/index.ts server galileo",
    "dev:server:apollo": "tsx watch src/index.ts server apollo",
    "dev:server:amadeus": "tsx watch src/index.ts server amadeus",
    "dev:server:worldspan": "tsx watch src/index.ts server worldspan",
    "start:client": "tsx src/index.ts terminal:tcp",
    "start:terminal": "tsx src/index.ts terminal",
    "start:terminal:sabre": "tsx src/index.ts terminal sabre",
    "start:terminal:galileo": "tsx src/index.ts terminal galileo",
    "start:terminal:apollo": "tsx src/index.ts terminal apollo",
    "start:terminal:amadeus": "tsx src/index.ts terminal amadeus",
    "start:terminal:worldspan": "tsx src/index.ts terminal worldspan",
    "start:terminal:tcp": "tsx src/index.ts terminal:tcp",
    "scenario": "tsx src/index.ts scenario",
    "validate:live-galileo": "tsx validate-galileo-handler-live.ts",
    "validate:creds": "tsx validate-travelport-creds.ts",
    "validate:stays-creds": "tsx validate-stays-creds.ts",
    "validate:diff-oracle": "tsx validate-galileo-diff-oracle.ts",
    "validate:diff-oracle:apollo": "tsx validate-galileo-diff-oracle.ts --dialect=apollo",
    "validate:diff-oracle:worldspan": "tsx validate-galileo-diff-oracle.ts --dialect=worldspan",
    "validate:live-galileo:capture": "TVP_CAPTURE=./tvp-recording.jsonl tsx validate-galileo-handler-live.ts",
    "validate:live-galileo:replay": "TVP_REPLAY=./tvp-recording.jsonl tsx validate-galileo-handler-live.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:json": "vitest run --reporter=json --outputFile=.vitest-report.json",
    "test:junit": "vitest run --reporter=junit --outputFile=junit.xml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  }
}
